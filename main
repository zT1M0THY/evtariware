                PointsDD:SetValues(list)
                if selectName then
                    for _, v in ipairs(list) do
                        if string.find(v, "^" .. selectName .. "|") then
                            PointsDD:SetValue(v)
                            break
                        end
                    end
                end
            end)
        end
