        return tostring(tonumber(d) or 0)
    end

    local function RenumberPoints()
        for i, pt in ipairs(currentPoints) do
            pt.Name = "Point" .. i
        end
    end

    local function GetNextPointName()
        local used = {}
        for _, pt in ipairs(currentPoints) do used[pt.Name] = true end
        local i = 1
        while used["Point" .. i] do i = i + 1 end
        return "Point" .. i
    end

    local function RefreshPointsDropdown(selectName)
        local list = {}
        for _, pt in ipairs(currentPoints) do table.insert(list, string.format("%s|%s|%s", pt.Name, pt.Action, FormatDelay(pt.Delay))) end
        if #list == 0 then
            table.insert(list, "No Points")
            if PointsDD then
                pcall(function()
                    PointsDD:SetValues(list)
                    PointsDD:SetValue("No Points")
                end)
            end
            return
        end
        
        if PointsDD then
            pcall(function()
                PointsDD:SetValues(list)
                if selectName then
                    for _, v in ipairs(list) do
                        if string.find(v, "^" .. selectName .. "|") then PointsDD:SetValue(v); break end
                    end
                end
            end)
        end
    end

    local function PopulateUIForEdit(animId)
        selAnimId = animId
        getgenv().ParryConfig.SelectedAnimId = animId
        if Options.AnimIDInput then Options.AnimIDInput:SetValue(animId) end

        local p = getgenv().ParryConfig.Profiles[animId]
        if p then
            originalSaveName = p.Name; saveName = p.Name
            isUpdatingTimingUI = true
            if Options.TimingNameInput then Options.TimingNameInput:SetValue(p.Name) end
            isUpdatingTimingUI = false

            if p.Hitbox and Options.HitboxSize then
                currentHitbox = NormalizeHitbox(p.Hitbox, p.HitboxSize)
                Options.HitboxSize:SetValue(currentHitbox.Size)
                Options.HitboxSizeInput:SetValue(tostring(currentHitbox.Size))
                Options.HitboxShape:SetValue(currentHitbox.Shape)
                Options.HitboxTransparency:SetValue(currentHitbox.Transparency)
                if Options.HitboxVisualizerToggle and Options.HitboxVisualizerToggle.Value then StartHitboxVisualizer() end
            end

            currentPoints = {}
            for _, pt in ipairs(p.Points) do table.insert(currentPoints, {Name = pt.Name, Action = pt.Action, Delay = pt.Delay}) end
            RenumberPoints()
            RefreshPointsDropdown(currentPoints[1] and currentPoints[1].Name)
        else
            originalSaveName = ""; saveName = ""
            if Options.TimingNameInput then Options.TimingNameInput:SetValue("") end
            currentPoints = {}; RefreshPointsDropdown()
        end
    end

    -- ==========================================
    -- TAB 1: COMBAT
    -- ==========================================
    local Assist = Tabs.Combat:AddLeftGroupbox('Assistance')
    Assist:AddToggle('ADM', {Text = 'Auto Defense', Default = false, Callback = function(v) getgenv().ParryConfig.Enabled = v end})
    Assist:AddToggle('ROC', {Text = 'Roll If Parry On Cooldown', Default = false, Callback = function(v) getgenv().ParryConfig.RollOnParryCooldown = v end})
    Assist:AddToggle('RIB', {Text = 'Roll If Opponent Is Behind You', Default = false, Callback = function(v) getgenv().ParryConfig.RollIfBehind = v end})

    Assist:AddSlider('RDO', {Text = 'Roll Delay Offset', Default = 0, Min = -1, Max = 1, Rounding = 3, Callback = function(v)
        getgenv().ParryConfig.RollDelayOffset = v
        if not isUpdatingUI and Options.RDOInput then isUpdatingUI = true; Options.RDOInput:SetValue(tostring(v)); isUpdatingUI = false end
    end})
    Assist:AddInput('RDOInput', {Default = '0', Text = 'Precise Roll Delay Offset', Placeholder = 'e.g. -0.1', Finished = true, Callback = function(v)
        local num = tonumber(v)
        if num then
            getgenv().ParryConfig.RollDelayOffset = num
            if not isUpdatingUI and Options.RDO then isUpdatingUI = true; Options.RDO:SetValue(num); isUpdatingUI = false end
        end
    end})

    Assist:AddToggle('ARC', {Text = 'Roll Cancel', Default = false, Callback = function(v) getgenv().ParryConfig.AutoRollCancel = v end})
    Assist:AddToggle('RTF', {Text = 'React to Feints', Default = false, Callback = function(v) getgenv().ParryConfig.ReactToFeints = v end})
    
    Assist:AddSlider('RCD', {Text = 'Roll Cancel Delay', Default = 0.1, Min = 0, Max = 1, Rounding = 3, Callback = function(v) 
        getgenv().ParryConfig.RollCancelDelay = v 
        if not isUpdatingUI and Options.RCDInput then isUpdatingUI = true; Options.RCDInput:SetValue(tostring(v)); isUpdatingUI = false end
    end})
    Assist:AddInput('RCDInput', {Default = '0.1', Text = 'Precise Roll Cancel Delay', Placeholder = 'e.g. 0.25', Finished = true, Callback = function(v)
        local num = tonumber(v)
        if num then
            getgenv().ParryConfig.RollCancelDelay = num
            if not isUpdatingUI and Options.RCD then isUpdatingUI = true; Options.RCD:SetValue(num); isUpdatingUI = false end
        end
    end})

    -- BLOCK INPUT GROUP (moved under Assistance)
    local BlockGroup = Tabs.Combat:AddLeftGroupbox('Block Input')
    BlockGroup:AddToggle('BI', {Text = 'Enable Block Input', Default = false, Callback = function(v) getgenv().ParryConfig.BlockInputEnabled = v end})
    BlockGroup:AddSlider('BIHB', {Text = 'Block Hitbox Multiplier', Default = 1, Min = 0.1, Max = 5, Rounding = 2, Callback = function(v)
        getgenv().ParryConfig.BlockInputHitboxMultiplier = v
        if not isUpdatingUI and Options.BIHBInput then isUpdatingUI = true; Options.BIHBInput:SetValue(tostring(v)); isUpdatingUI = false end
    end})
    BlockGroup:AddInput('BIHBInput', {Default = '1', Text = 'Precise Block Hitbox Mult', Placeholder = 'e.g. 1.5', Finished = true, Callback = function(v)
        local num = tonumber(v)
        if num then
            getgenv().ParryConfig.BlockInputHitboxMultiplier = num
            if not isUpdatingUI and Options.BIHB then isUpdatingUI = true; Options.BIHB:SetValue(num); isUpdatingUI = false end
        end
    end})
    BlockGroup:AddSlider('BIPT', {Text = 'Punishable Time (Seconds)', Default = 0.5, Min = 0, Max = 2, Rounding = 2, Callback = function(v)
        getgenv().ParryConfig.BlockInputPunishableTime = v
        if not isUpdatingUI and Options.BIPTInput then isUpdatingUI = true; Options.BIPTInput:SetValue(tostring(v)); isUpdatingUI = false end
    end})
    BlockGroup:AddInput('BIPTInput', {Default = '0.5', Text = 'Precise Punishable Time', Placeholder = 'e.g. 0.5', Finished = true, Callback = function(v)
        local num = tonumber(v)
        if num then
            getgenv().ParryConfig.BlockInputPunishableTime = num
            if not isUpdatingUI and Options.BIPT then isUpdatingUI = true; Options.BIPT:SetValue(num); isUpdatingUI = false end
        end
    end})
    BlockGroup:AddDropdown('BIBlock', {
        Values = {'M1s', 'Skills (2,3,4,5)', 'Weapon Skills (E,R)'},
        Default = {'M1s', 'Skills (2,3,4,5)', 'Weapon Skills (E,R)'},
        Multi = true,
