-- ==========================================
-- HELPERS
-- ==========================================
local function GetCleanAnimId(id)
    if not id then return "" end
    return tostring(id):match("%d+") or tostring(id)
end

local function IsOpponentBehind(enemyChar)
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    local enemyHRP = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
    if not myHRP or not enemyHRP then return false end
    local toEnemy = Vector3.new(enemyHRP.Position.X - myHRP.Position.X, 0, enemyHRP.Position.Z - myHRP.Position.Z)
    if toEnemy.Magnitude < 0.01 then return false end
    return myHRP.CFrame.LookVector:Dot(toEnemy.Unit) < 0
end

local function IsFeintPlaying(char)
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Sound") and v.SoundId == "rbxassetid://9119744642" and v.IsPlaying then
            return true
        end
    end
    return false
end

-- ==========================================
-- TRUE DODGE
-- ==========================================
local function FireDash()
    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if not remotes then return end
    local global = remotes:FindFirstChild("Global")
    if not global then return end
    local movement = global:FindFirstChild("Movement")
    if not movement then return end
    local dashRemote = movement:FindFirstChild("Dash")
    
    if dashRemote and dashRemote:IsA("RemoteEvent") then
        pcall(function()
            dashRemote:FireServer(true, workspace:GetServerTimeNow())
        end)
    end
end

local function PlayTrueDodgeAnimation()
    if not getgenv().ParryConfig.TrueDodgeAnimation then return end
    local now = os.clock()
    if now - lastTrueDodgeAnimTime < 1.2 then return end
    lastTrueDodgeAnimTime = now

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end

    local animObj = Instance.new("Animation")
    animObj.AnimationId = "rbxassetid://96734309965914"
    local success, track = pcall(function() return animator:LoadAnimation(animObj) end)
    
    if success and track then
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = false
        track:Play(0.1)
    end
end

-- Keybind Execution
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not getgenv().ParryConfig.TrueDodgeEnabled then return end
    
    local keyToPress = nil
    if Options.TrueDodgeKey and Options.TrueDodgeKey.Value then
        keyToPress = Options.TrueDodgeKey.Value
    end
    
    if keyToPress and input.KeyCode.Name == keyToPress then
        FireDash()
        PlayTrueDodgeAnimation()
    end
end)

-- ==========================================
-- COUNTER COOLDOWN TRACKING
-- ==========================================
local function GetReadyCounterSlot()
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then return nil end
    local Toolbar = PlayerGui:FindFirstChild("Toolbar")
    if not Toolbar then return nil end
    local MainFrame = Toolbar:FindFirstChild("MainFrame")
    if not MainFrame then return nil end

    local targets = {"checkmate", "wide open"}
    local slotNames = {"One", "Two", "Three", "Four", "Five"}

    for i, slotName in ipairs(slotNames) do
        local slot = MainFrame:FindFirstChild(slotName)
        if slot then
            local nameLabel = slot:FindFirstChild("Name")
            local cdCounter = slot:FindFirstChild("CDCounter")

            if nameLabel and nameLabel:IsA("TextLabel") then
                local nameText = string.lower(nameLabel.Text)
                for _, target in ipairs(targets) do
                    if string.find(nameText, target) then
                        local isReady = true
                        if cdCounter and cdCounter:IsA("TextLabel") then
                            if cdCounter.Visible and cdCounter.Text ~= "" and cdCounter.Text ~= "0" then
                                isReady = false
                            end
                        end
                        if isReady then return i end
                    end
                end
            end
        end
    end
    return nil
end

local function ExecuteCounter()
    local slotNum = GetReadyCounterSlot()
    if slotNum then
        local keyCodes = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five }
        local key = keyCodes[slotNum]
        if key then
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            return "Counter"
        end
    end
    return nil
end

-- ==========================================
-- PRECISE COOLDOWNS (PlayerInfo -> WeaponCooldown)
-- ==========================================
local function GetWeaponCooldownContainer()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local info = pg and pg:FindFirstChild("PlayerInfo")
    local main = info and info:FindFirstChild("MainBG")
    return main and main:FindFirstChild("WeaponCooldown")
end

local function ParseCooldownSeconds(frame)
    if not frame then return nil end

    local timeObj = frame:FindFirstChild("Time")
    if not timeObj then
        timeObj = frame:FindFirstChild("Time", true)
    end
    if not timeObj then return nil end

    local text = timeObj.Text
    if text == nil then return nil end
    text = tostring(text)

    local num = tonumber(text)
    if num then return num end

    local digits = text:match("(%d+%.?%d*)")
    return digits and tonumber(digits) or nil
end

-- Returns remaining seconds. 0 = ready. nil = UI could not be read.
local function GetGuiCooldownRemaining(frameName)
    local wc = GetWeaponCooldownContainer()
    if not wc then return nil end

    local frame = wc:FindFirstChild(frameName)
    if not frame then return 0 end

    local seconds = ParseCooldownSeconds(frame)
    if seconds ~= nil then
        if seconds < 0 then seconds = 0 end
        return seconds
    end

    if frame:IsA("GuiObject") and not frame.Visible then
        return 0
    end

    return nil
end

local function GetParryCooldownRemaining()
    return GetGuiCooldownRemaining("Parry")
end

local function GetDashCooldownRemaining()
    return GetGuiCooldownRemaining("Dash")
end

-- Use the real UI cooldowns when available, otherwise keep the old estimates.
local function GetCooldownState()
    local now = os.clock()
    local parryLeft = GetParryCooldownRemaining()
    local dashLeft = GetDashCooldownRemaining()

    if parryLeft == nil then
        parryLeft = math.max(0, PARRY_COOLDOWN_TIME - (now - lastParryPress))
    end
    if dashLeft == nil then
        dashLeft = math.max(0, ROLL_KEY_COOLDOWN - (now - lastRollKey))
    end

    return parryLeft, dashLeft
end

local function SelectFallbackAction(enemyChar, allowCounter)
    if allowCounter == nil then allowCounter = true end

    local cfg = getgenv().ParryConfig
    local parryLeft, dashLeft = GetCooldownState()
    local counterReady = false
    if allowCounter then
        counterReady = GetReadyCounterSlot() ~= nil
    end

    -- Positional override: if they're behind you, roll when dash is available,
    -- even if parry itself is ready.
    if cfg.RollIfBehind and IsOpponentBehind(enemyChar) and dashLeft <= 0 then
        return "Roll"
    end

    if allowCounter and cfg.CounterInsteadOfParry and counterReady then
        return "Counter"
    end

    if parryLeft <= 0 then
        return "Parry"
    end

    if cfg.RollOnParryCooldown and dashLeft <= 0 then
        return "Roll"
    end

    if allowCounter and cfg.CounterAsFallback and counterReady then
        return "Counter"
    end

    return "Parry"
end

local function ClampPercent(v)
    v = tonumber(v) or 0
    if v < 0 then return 0 end
    if v > 100 then return 100 end
    return v
end

-- Normalizes a pair of exclusive chances. If they total more than 100%,
-- they are scaled down proportionally. Any leftover under 100% belongs to
-- the normal action.
local function NormalizePair(a, b)
    a = ClampPercent(a)
    b = ClampPercent(b)
    local total = a + b
    if total > 100 then
        local scale = 100 / total
        a = a * scale
        b = b * scale
    end
    return a, b
end

-- Counter chance is deliberately independent of the Humanization toggle.
-- It only needs a counter feature (Auto Counter or Counter Fallback) enabled.
local function ApplyCounterChance(action, enemyChar)
    if action ~= "Counter" then return action end

    local cfg = getgenv().ParryConfig
    if not (cfg.CounterInsteadOfParry or cfg.CounterAsFallback) then
        return action
    end

    local counterChance, missedCounterChance = NormalizePair(
        cfg.HumanizeCounterChance,
        cfg.HumanizeMissedCounterChance
    )

    local roll = math.random() * 100
    if roll < counterChance then
        return "Counter"
    elseif roll < counterChance + missedCounterChance then
        return nil
    end

    -- Counter was skipped: fall back to the normal defensive action.
    return SelectFallbackAction(enemyChar, false)
end

local function ApplyHumanization(action, enemyChar)
    local cfg = getgenv().ParryConfig
    if not cfg.HumanizationEnabled or not action then
        return action
    end

    if action == "Counter" then
        return action
    end

    if action == "Parry" then
        local rollChance, missChance = NormalizePair(
            cfg.HumanizeRollChance,
            cfg.HumanizeMissedReactionChance
        )
        local roll = math.random() * 100

        if roll < rollChance then
            local _, dashLeft = GetCooldownState()
            if dashLeft <= 0 then
                return "Roll"
            end
            return "Parry"
        elseif roll < rollChance + missChance then
            return nil
        end
        return "Parry"
    end

    if action == "Roll" then
        local _, missChance = NormalizePair(
            cfg.HumanizeRollChance,
            cfg.HumanizeMissedReactionChance
        )
        if math.random() * 100 < missChance then
            return nil
        end
        return "Roll"
    end

    return action
end

-- ==========================================
-- HITBOX (CUBE + SPHERE, CENTERED ON HRP)
-- ==========================================
local VALID_SHAPES = { Cube = true, Sphere = true }

local function MakeDefaultHitbox(s)
    s = tonumber(s) or 25
    return {Size = s, Shape = "Cube", ColorR = 1, ColorG = 0.2, ColorB = 0.2, Transparency = 0.5}
end

local function NormalizeHitbox(hb, legacy)
    if type(hb) ~= "table" then return MakeDefaultHitbox(legacy) end
    local d = MakeDefaultHitbox(legacy)
    local size = d.Size
    if hb.SizeX and hb.SizeY and hb.SizeZ then
        size = (hb.SizeX + hb.SizeY + hb.SizeZ) / 3
    elseif hb.Size then
        size = tonumber(hb.Size) or d.Size
    end
    local shape = hb.Shape
    if type(shape) ~= "string" or not VALID_SHAPES[shape] then
        shape = d.Shape
    end
    return {
        Size = size,
        Shape = shape,
        ColorR = tonumber(hb.ColorR) or d.ColorR,
        ColorG = tonumber(hb.ColorG) or d.ColorG,
        ColorB = tonumber(hb.ColorB) or d.ColorB,
        Transparency = tonumber(hb.Transparency) or d.Transparency
    }
end

local function IsEnemyInHitbox(enemyChar, hitbox)
    local myChar = LocalPlayer.Character
    if not myChar or not enemyChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    local enemyHrp = enemyChar:FindFirstChild("HumanoidRootPart")
    if not myHrp or not enemyHrp then return false end

    local hb = NormalizeHitbox(hitbox)
    local relPos = myHrp.CFrame:PointToObjectSpace(enemyHrp.Position)
    local half = hb.Size / 2

    if hb.Shape == "Sphere" then
        return relPos.Magnitude <= half
    else
        return math.abs(relPos.X) <= half
           and math.abs(relPos.Y) <= half
           and math.abs(relPos.Z) <= half
    end
end

local currentHitbox = MakeDefaultHitbox(25)
local HitboxVisualizerPart, HitboxVisualizerConn = nil, nil

local function StopHitboxVisualizer()
    if HitboxVisualizerConn then HitboxVisualizerConn:Disconnect(); HitboxVisualizerConn = nil end
    if HitboxVisualizerPart then pcall(function() HitboxVisualizerPart:Destroy() end); HitboxVisualizerPart = nil end
end

local function StartHitboxVisualizer()
    StopHitboxVisualizer()
    local part = Instance.new("Part")
    part.Name = "Evtariware_Preview"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Material = Enum.Material.ForceField
    part.Parent = workspace
    HitboxVisualizerPart = part

    HitboxVisualizerConn = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or not HitboxVisualizerPart then
            if HitboxVisualizerPart then HitboxVisualizerPart.Transparency = 1 end
            return
        end
        local hb = currentHitbox
        local size = hb.Size or 25
        local wantShape = (hb.Shape == "Sphere") and Enum.PartType.Ball or Enum.PartType.Block

        if HitboxVisualizerPart.Shape ~= wantShape then
            HitboxVisualizerPart.Shape = wantShape
        end
        HitboxVisualizerPart.Size = Vector3.new(size, size, size)
        HitboxVisualizerPart.Transparency = hb.Transparency
        HitboxVisualizerPart.Color = Color3.new(hb.ColorR, hb.ColorG, hb.ColorB)
        HitboxVisualizerPart.CFrame = hrp.CFrame
    end)
end

-- ==========================================
-- LOCAL ANIM PREVIEW
-- ==========================================
local function StopLocalCharacterAnimation()
    if localPreviewTrack then
        pcall(function() localPreviewTrack:Stop() end)
        pcall(function() localPreviewTrack:Destroy() end)
        localPreviewTrack = nil
    end
end

local function PreviewAnimation(animId)
    StopLocalCharacterAnimation()
    if not animId or animId == "" then return Library:Notify("No animation selected!", 3) end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then return Library:Notify("Animator not found!", 3) end

    local cleanId = GetCleanAnimId(animId)
    local animObject = Instance.new("Animation")
    animObject.AnimationId = "rbxassetid://" .. cleanId
    local success, track = pcall(function() return animator:LoadAnimation(animObject) end)

    if success and track then
        localPreviewTrack = track
        track.Looped = false
        track.Priority = Enum.AnimationPriority.Action
        track:Play(0.0, 1, 1)
        Library:Notify("Playing animation " .. cleanId, 3)
    else
        Library:Notify("Failed to load animation!", 3)
    end
end

-- ==========================================
-- BLACKLIST SYSTEM
-- ==========================================
local function SaveBlacklist()
    local arr = {}
    for id in pairs(getgenv().ParryConfig.Blacklist) do table.insert(arr, tostring(id)) end
    pcall(function() writefile(BlacklistFile, HttpService:JSONEncode(arr)) end)
end

local function LoadBlacklist()
    getgenv().ParryConfig.Blacklist = {}
    if not isfile(BlacklistFile) then return end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(BlacklistFile)) end)
    if ok and type(decoded) == "table" then
        for _, id in ipairs(decoded) do if id then getgenv().ParryConfig.Blacklist[tostring(id)] = true end end
    end
end

local function IsBlacklisted(id) return getgenv().ParryConfig.Blacklist[tostring(id)] == true end
local function AddBlacklist(id) if id and id ~= "" then getgenv().ParryConfig.Blacklist[tostring(id)] = true; SaveBlacklist(); return true end return false end
local function RemoveBlacklist(id) if id then getgenv().ParryConfig.Blacklist[tostring(id)] = nil; SaveBlacklist(); return true end return false end

-- ==========================================
-- TIMING SYSTEM
-- ==========================================
local timingFileAnimCache = {}

local function SaveTimingFile(name, animId, points, hitbox)
    if not name or name == "" then return false, "No name" end
    if not animId or animId == "" then return false, "No ID" end
    local data = {AnimId = animId, Name = name, Points = points, Hitbox = hitbox, Enabled = true}
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false, "Encode failed" end
    local ok2 = pcall(function() writefile(TimingsFolder .. "/" .. name .. ".json", enc) end)
    if not ok2 then return false, "Write failed" end
    timingFileAnimCache[name] = animId
    return true
end

local function LoadTimingFile(name)
    local path = TimingsFolder .. "/" .. name .. ".json"
    if not isfile(path) then return nil end
    local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or not dec or not dec.AnimId then return nil end
    
    local points = dec.Points
    if not points then
        points = { {Name="Point1", Action=dec.Action or "Parry", Delay=dec.Delay or 0.15} }
    end

    getgenv().ParryConfig.Profiles[dec.AnimId] = {
        Name = dec.Name or name, 
        Points = points, 
        Hitbox = NormalizeHitbox(dec.Hitbox, dec.HitboxSize), 
        Enabled = true
    }
    timingFileAnimCache[name] = dec.AnimId
    return dec
end

local function DeleteTimingFile(name)
    local path = TimingsFolder .. "/" .. name .. ".json"
    if isfile(path) then pcall(function() delfile(path) end); timingFileAnimCache[name] = nil; return true end
    return false
end

local function ListTimingFiles()
    local l, seenN, seenID = {}, {}, {}
    if isfolder(TimingsFolder) then
        for _, file in ipairs(listfiles(TimingsFolder)) do
            local name = file:match("([^/\\]+)%.json$")
            if name and not seenN[name] then
                seenN[name] = true
                local id = timingFileAnimCache[name]
                if id == nil then
                    local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
                    id = (ok and dec and dec.AnimId) or false
                    timingFileAnimCache[name] = id or nil
                end
                if id and id ~= false then
                    if not seenID[id] then seenID[id] = true; table.insert(l, name) end
                else
                    table.insert(l, name)
                end
            end
        end
    end
    table.sort(l)
    if #l == 0 then table.insert(l, "None") end
    return l
end

local function ListLoadedTimings()
    local l, seen = {}, {}
    for id, p in pairs(getgenv().ParryConfig.Profiles) do
        if not IsBlacklisted(id) and not seen[id] then
            seen[id] = true
            table.insert(l, string.format("%s [%s]", p.Name or "Unnamed", id))
        end
    end
    table.sort(l)
    if #l == 0 then table.insert(l, "None") end
    return l
end

local function ListBlacklisted()
    local l = {}
    for id in pairs(getgenv().ParryConfig.Blacklist) do table.insert(l, "[" .. tostring(id) .. "]") end
    table.sort(l)
    if #l == 0 then table.insert(l, "None") end
    return l
end

local function LoadAllTimings()
    local count = 0
    timingFileAnimCache = {}
    if isfolder(TimingsFolder) then
        for _, file in ipairs(listfiles(TimingsFolder)) do
            local name = file:match("([^/\\]+)%.json$")
            if name and LoadTimingFile(name) then count = count + 1 end
        end
    end
    return count
end

-- ==========================================
-- CORE ACTIONS
-- ==========================================
local function SendParryKey()
    local now = os.clock()
    if now - lastParryKey < PARRY_KEY_COOLDOWN then return false end
    lastParryKey = now
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    return true
end

local function SendRollKey()
    local now = os.clock()
    if now - lastRollKey < ROLL_KEY_COOLDOWN then return false end
    lastRollKey = now
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
    -- Release the key without blocking, so the roll-cancel timer starts at the
    -- actual moment the roll was pressed.
    task.delay(0.05, function()
        pcall(function()
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
        end)
    end)
    return true
end

local function ExecuteParry() if SendParryKey() then lastParryPress = os.clock(); return true end return false end
local function ExecuteRoll() return SendRollKey() end

-- Roll cancel in this game is a right-click CLICK (press + release). The
-- DashCancel remote does nothing, and a press without the release does nothing.
local function ExecuteRollCancel()
    if type(mouse2click) == "function" then
        if pcall(mouse2click) then return true end
    end

    if type(mouse2press) == "function" then
        if pcall(mouse2press) then
            task.delay(0.05, function()
                if type(mouse2release) == "function" then pcall(mouse2release) end
            end)
            return true
        end
    end

    local loc = UserInputService:GetMouseLocation()
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 2, true, game, 1)
    end)
    if ok then
        task.delay(0.05, function()
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(loc.X, loc.Y, 2, false, game, 1)
            end)
        end)
    end
    return ok
end

local function ExecuteAction(action)
    if action == "Roll" then
        if not ExecuteRoll() then
            -- The roll key was throttled, so nothing is rolling. Parry instead
            -- of firing a cancel into nothing.
            ExecuteParry()
            return "Parry"
        end

        -- Roll cancel belongs to the roll itself, so it is scheduled here, at
        -- the moment the roll key is sent, regardless of what caused the roll.
        if getgenv().ParryConfig.AutoRollCancel then
            local cancelDelay = tonumber(getgenv().ParryConfig.RollCancelDelay) or 0
            if cancelDelay < 0 then cancelDelay = 0 end
            task.delay(cancelDelay, function()
                -- A zero delay should still cancel, but the dash has to be
                -- registered first, so give it one frame.
                if cancelDelay <= 0 then task.wait() end
                pcall(ExecuteRollCancel)
            end)
        end
        return "Roll"
    end
    if action == "Counter" then
        local res = ExecuteCounter()
        if res then return res end
        ExecuteParry()
        return "Parry"
    end
    ExecuteParry()
    return "Parry"
end

-- ==========================================
-- LOGGER & PARRY SYSTEM
-- ==========================================
local function LogAnimation(cleanId, animName, isSelf)
    if cleanId == "" then return end
    if not LoggedAnimations[cleanId] then
        LoggedAnimations[cleanId] = {Name = animName, Id = cleanId, Count = 1, Source = isSelf and "Self" or "Enemy"}
    else
        LoggedAnimations[cleanId].Count = LoggedAnimations[cleanId].Count + 1
        if isSelf then LoggedAnimations[cleanId].Source = "Self" end
    end
    if RefreshAllDropdowns then task.spawn(function() task.wait(0.1); pcall(RefreshAllDropdowns) end) end
end

local function OnAnimationPlayed(humanoid, track)
    if not humanoid or not track then return end

    pcall(function()
        if not track.Animation then return end
        local char = humanoid.Parent
        if not char then return end

        local isSelf = (char == LocalPlayer.Character)
        if isSelf and not getgenv().ParryConfig.LogOwnAnimations then return end

        if loggingEnabled then
            local skip = false
            if not isSelf and getgenv().ParryConfig.LoggerDistanceCheck then
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local enemyHrp = char:FindFirstChild("HumanoidRootPart")
                if myHrp and enemyHrp and (myHrp.Position - enemyHrp.Position).Magnitude > getgenv().ParryConfig.LoggerMaxDistance then
                    skip = true
                end
            end
            if not skip then
                local cleanId = GetCleanAnimId(tostring(track.Animation.AnimationId))
                local animName = (track.Name ~= "" and track.Name) or ("ID: " .. cleanId)
                LogAnimation(cleanId, animName, isSelf)
            end
        end

        if isSelf then return end

        local cleanId = GetCleanAnimId(tostring(track.Animation.AnimationId))
        if IsBlacklisted(cleanId) then return end

        if ActiveTracks[track] then return end
        ActiveTracks[track] = true
        FeintedTracks[track] = false
        
        track.Stopped:Connect(function()
            ActiveTracks[track] = nil
            FeintedTracks[track] = nil
        end)

        if getgenv().ParryConfig.OnlyTargetPlayer then
            local wanted = getgenv().ParryConfig.TargetPlayerName or ""
            if wanted == "" or char.Name ~= wanted then return end
        end

        local profile = getgenv().ParryConfig.Profiles[cleanId]
        if not (profile and profile.Enabled) then return end

        local pointsToRun = {}
        
        if getgenv().ParryConfig.DefendSelectedPointEnabled then
            if cleanId == getgenv().ParryConfig.SelectedAnimId then
                for _, pt in ipairs(profile.Points) do
                    if pt.Name == getgenv().ParryConfig.SelectedPointName then
                        table.insert(pointsToRun, pt)
                        break
                    end
                end
            end
        elseif getgenv().ParryConfig.DefendSelectedTimingEnabled then
            if cleanId == getgenv().ParryConfig.SelectedAnimId then
                pointsToRun = profile.Points
            end
        elseif getgenv().ParryConfig.Enabled then
            pointsToRun = profile.Points
        end

        if #pointsToRun == 0 then return end

        local hb = profile.Hitbox or MakeDefaultHitbox(profile.HitboxSize or 25)
        -- Don't range-check here. An attack can start outside the hitbox and
        -- move into range during its windup. Range is validated at the actual
        -- reaction point inside each spawned point task below.

        for _, pt in ipairs(pointsToRun) do
            task.spawn(function()
                if FeintedTracks[track] then return end

                local timePassed = track.TimePosition or 0
                local targetDelay = (pt.Delay or 0.15) + (getgenv().ParryConfig.GlobalDelayOffset / 1000)
                
                if timePassed > targetDelay then
                    return
                end

                local baseDelay = targetDelay - timePassed

                local willBeCounter = false
                if (pt.Action or "Parry") == "Parry" then
                    local cfg = getgenv().ParryConfig
                    local parryCDLeft, rollCDLeft = GetCooldownState()
                    local counterReady = GetReadyCounterSlot() ~= nil
                    local parryReadyAtTrigger = parryCDLeft <= baseDelay
                    local dashReadyAtTrigger = rollCDLeft <= baseDelay
                    local rollBehind = cfg.RollIfBehind and IsOpponentBehind(char) and dashReadyAtTrigger

                    if not rollBehind then
                        if cfg.CounterInsteadOfParry and counterReady then
                            willBeCounter = true
                        elseif cfg.CounterAsFallback and counterReady then
                            local rollOnCD = cfg.RollOnParryCooldown and dashReadyAtTrigger
                            if not parryReadyAtTrigger and not rollOnCD then
                                willBeCounter = true
                            end
                        end
                    end
                end

                local delay = baseDelay
                if willBeCounter then
                    delay = delay + (getgenv().ParryConfig.CounterDelayOffset or 0)
                    if delay < 0 then delay = 0 end
                end

                if getgenv().ParryConfig.HumanizationEnabled then
                    local jitter = math.floor(tonumber(getgenv().ParryConfig.HumanizeReactionJitter) or 0)
                    if jitter > 0 then
                        delay = delay + (math.random(-jitter, jitter) / 1000)
                        if delay < 0 then delay = 0 end
                    end
                end

                local startClock = os.clock()
                local shouldFire = true
                local triggeredEarly = false
                
                if delay > 0 then
                    while os.clock() - startClock < delay do
                        if FeintedTracks[track] then
                            shouldFire = false
                            break
                        end

                        if not track.IsPlaying then
                            if getgenv().ParryConfig.ReactToFeints and IsFeintPlaying(char) then
                                FeintedTracks[track] = true

                                local reactChance = 100
                                if getgenv().ParryConfig.HumanizationEnabled then
                                    reactChance = ClampPercent(getgenv().ParryConfig.HumanizeReactToFeintChance)
                                end

                                if math.random() * 100 < reactChance then
                                    triggeredEarly = true
                                else
                                    shouldFire = false
                                end
                                break
                            else
                                shouldFire = false
                                break
                            end
                        end

                        if not char.Parent or not char:FindFirstChild("HumanoidRootPart") then
                            shouldFire = false
                            break
                        end
                        task.wait()
                    end
                end

                if not shouldFire then return end
                if not triggeredEarly and not track.IsPlaying then return end

                -- Validate range at the moment the parry actually fires.
                -- This allows "started outside, entered the hitbox during the
                -- animation" reactions.
                if not IsEnemyInHitbox(char, hb) then
                    return
                end

                -- Apply the optional max-distance limit at reaction time too,
                -- instead of only at animation start.
                if getgenv().ParryConfig.LimitMaxDistance then
                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local enemyHrp = char:FindFirstChild("HumanoidRootPart")
                    if not myHrp or not enemyHrp then return end
                    if (myHrp.Position - enemyHrp.Position).Magnitude > getgenv().ParryConfig.MaxDistance then
                        return
                    end
                end

                local action = pt.Action or "Parry"

                if action == "Parry" then
                    action = SelectFallbackAction(char)
                end

                action = ApplyCounterChance(action, char)
                action = ApplyHumanization(action, char)

                if action then
                    ExecuteAction(action)
                end
            end)
        end
    end)
end

local function HookCharacter(player, char)
    task.spawn(function()
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then
            hum = char:FindFirstChildOfClass("AnimationController")
        end
        if not hum then return end

        local anim = hum:WaitForChild("Animator", 10)
        if anim then
            anim.AnimationPlayed:Connect(function(t) pcall(OnAnimationPlayed, hum, t) end)
        else
            hum.ChildAdded:Connect(function(c)
                if c:IsA("Animator") then
                    c.AnimationPlayed:Connect(function(t) pcall(OnAnimationPlayed, hum, t) end)
                end
            end)
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        if p.Character then HookCharacter(p, p.Character) end
        p.CharacterAdded:Connect(function(c) HookCharacter(p, c) end)
    end
end
Players.PlayerAdded:Connect(function(p)
    if p == LocalPlayer then return end
    if p.Character then HookCharacter(p, p.Character) end
    p.CharacterAdded:Connect(function(c) HookCharacter(p, c) end)
end)
if LocalPlayer.Character then HookCharacter(LocalPlayer, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c) HookCharacter(LocalPlayer, c) end)

