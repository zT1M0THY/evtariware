    local okB, lb = pcall(function() return Glob:AddLabel('Comp: -- ms | Frame: -- ms') end)
    if okB then PingReadoutB = lb end
    task.spawn(function()
        while true do
            task.wait(0.5)
            local compMs = GetPingCompensation() * 1000
            local frameMs = GetFrameCorrection() * 1000
            if PingReadoutA then
                pcall(function()
                    PingReadoutA:SetText(string.format('Ping: %.0f ms | Jitter: %.0f ms', CachedPingMs, PingJitter))
                end)
            end
            if PingReadoutB then
                pcall(function()
                    PingReadoutB:SetText(string.format('Comp: %.0f ms | Frame: %.0f ms', compMs, frameMs))
                end)
            end
        end
    end)

