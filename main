        Callback = function(v)
            getgenv().ParryConfig.BlockInputM1 = false
            getgenv().ParryConfig.BlockInputSkills = false
            getgenv().ParryConfig.BlockInputWeaponSkills = false
            for _, val in pairs(v) do
                if val == 'M1s' then getgenv().ParryConfig.BlockInputM1 = true end
                if val == 'Skills (2,3,4,5)' then getgenv().ParryConfig.BlockInputSkills = true end
                if val == 'Weapon Skills (E,R)' then getgenv().ParryConfig.BlockInputWeaponSkills = true end
            end
        end
    })

