    BLeft_Active:AddButton('Unload All Timings', function() getgenv().ParryConfig.Profiles = {}; pcall(RefreshAllDropdowns, true); Library:Notify("Unloaded all timings.", 3) end)

    local BLeft3 = Tabs.Builder:AddLeftGroupbox('Blacklist Manager')
    BLDropdown = BLeft3:AddDropdown('BlacklistList', {Values = ListBlacklisted(), Default = 1, Text = 'Blacklisted Animations'})
    BLeft3:AddButton('Remove Selected', function()
        local v = BLDropdown.Value; if not v or v == "None" then return Library:Notify("None selected.", 3) end
        RemoveBlacklist(v:match("%[(%d+)%]") or v); pcall(RefreshAllDropdowns, true); Library:Notify("Removed from blacklist.", 3)
    end)
    BLeft3:AddButton('Clear Entire Blacklist', function()
        getgenv().ParryConfig.Blacklist = {}
        SaveBlacklist()
        pcall(RefreshAllDropdowns, true)
        Library:Notify("Blacklist cleared successfully.", 3)
    end)

    -- ==========================================
    -- TAB 2: BUILDER (RIGHT SIDE)
    -- ==========================================
    local BRight1 = Tabs.Builder:AddRightGroupbox('Timing Configuration')
    BRight1:AddInput('AnimIDInput', {Default = '', Text = 'Selected Animation ID', Placeholder = 'Select above or paste...', Callback = function(v) 
        selAnimId = GetCleanAnimId(v) 
        getgenv().ParryConfig.SelectedAnimId = selAnimId
    end})
    BRight1:AddInput('TimingNameInput', {Default = '', Text = 'Timing Name', Placeholder = 'Type name, then press Set Timing Name...', Finished = true, Callback = function(v) end})
    BRight1:AddButton('Set Timing Name', function()
        if selAnimId == "" then return Library:Notify("Select an animation first!", 3) end
        local typed = Options.TimingNameInput and Options.TimingNameInput.Value or ""
        if typed == nil or typed == "" then return Library:Notify("Type a name first!", 3) end

        local path = TimingsFolder .. "/" .. typed .. ".json"
        if isfile(path) then
            local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
            if ok and dec and dec.AnimId then
                if tostring(dec.AnimId) ~= tostring(selAnimId) then
                    return Library:Notify("Name '" .. typed .. "' already belongs to animation " .. tostring(dec.AnimId) .. ". Choose a different name.", 5)
                end
            end
        end

        saveName = typed
        Library:Notify("Timing name set to '" .. saveName .. "'. Now press 'Save Timing to File'.", 3)
    end)

    BRight1:AddDropdown('ActionType', {Values = {'Parry', 'Roll'}, Default = 'Parry', Text = 'Point Action', Callback = function(v) selAction = v end})

    BRight1:AddSlider('ParryDelaySec', {Text = 'Point Trigger Delay (Seconds)', Default = 0.15, Min = 0, Max = 5, Rounding = 3, Callback = function(v)
        timingInput = v
        if not isUpdatingTimingUI and Options.ParryDelayInput then
            isUpdatingTimingUI = true
            Options.ParryDelayInput:SetValue(tostring(v))
            isUpdatingTimingUI = false
        end
    end})

    BRight1:AddInput('ParryDelayInput', {
        Default = '0.15',
        Numeric = false,
        Finished = true,
        Text = 'Precise Point Trigger Delay',
        Placeholder = 'e.g. 0.153',
        Callback = function(v)
            local num = tonumber(v)
            if num then
                timingInput = num
                if not isUpdatingTimingUI and Options.ParryDelaySec then
                    isUpdatingTimingUI = true
                    Options.ParryDelaySec:SetValue(num)
                    isUpdatingTimingUI = false
                end
            end
        end
    })

    PointsDD = BRight1:AddDropdown('PointsList', {Values = {'No Points'}, Default = 1, Text = 'Reaction Points'})
    PointsDD:OnChanged(function(val)
        if not val or val == "No Points" then return end
        local pName = string.match(val, "^([^|]+)")
        getgenv().ParryConfig.SelectedPointName = pName
        
        for _, pt in ipairs(currentPoints) do
            if pt.Name == pName then
                isUpdatingTimingUI = true
                if Options.ActionType then Options.ActionType:SetValue(pt.Action) end
                if Options.ParryDelaySec then Options.ParryDelaySec:SetValue(pt.Delay) end
                if Options.ParryDelayInput then Options.ParryDelayInput:SetValue(tostring(pt.Delay)) end
                selAction = pt.Action
                timingInput = pt.Delay
                isUpdatingTimingUI = false
                break
            end
        end
    end)

    BRight1:AddButton('New Point', function()
        local nextNum = #currentPoints + 1
        local newName = "Point" .. nextNum
        table.insert(currentPoints, {Name = newName, Action = "Parry", Delay = 0})
        RefreshPointsDropdown(newName)
        getgenv().ParryConfig.SelectedPointName = newName
        
        isUpdatingTimingUI = true
        if Options.ActionType then Options.ActionType:SetValue("Parry") end
        if Options.ParryDelaySec then Options.ParryDelaySec:SetValue(0) end
        if Options.ParryDelayInput then Options.ParryDelayInput:SetValue("0") end
        selAction = "Parry"
        timingInput = 0
        isUpdatingTimingUI = false
    end)

    BRight1:AddButton('Save Point', function()
        local pName = getgenv().ParryConfig.SelectedPointName
        if not pName or pName == "" then return Library:Notify("No point selected!", 3) end
        
        for _, pt in ipairs(currentPoints) do
            if pt.Name == pName then
                pt.Action = selAction
                pt.Delay = timingInput
                break
            end
        end
        RefreshPointsDropdown(pName)
        Library:Notify("Saved " .. pName .. " changes.", 3)
    end)

    BRight1:AddToggle('DefendSelectedToggle', {Text = 'Defend Selected Timing', Default = false, Callback = function(v) getgenv().ParryConfig.DefendSelectedTimingEnabled = v end})
    BRight1:AddToggle('DefendSelectedPointToggle', {Text = 'Defend Selected Point', Default = false, Callback = function(v) getgenv().ParryConfig.DefendSelectedPointEnabled = v end})

    local BRight2 = Tabs.Builder:AddRightGroupbox('Hitbox Editor (Per-Animation)')

    BRight2:AddDropdown('HitboxShape', {
        Values = {'Cube', 'Sphere'},
        Default = 'Cube',
        Text = 'Hitbox Shape',
        Callback = function(v)
            if VALID_SHAPES[v] then
                currentHitbox.Shape = v
            end
        end
    })

    BRight2:AddSlider('HitboxSize', {Text = 'Hitbox Size', Default = 25, Min = 0.1, Max = 100, Rounding = 2, Callback = function(v) 
        currentHitbox.Size = v 
        if not isUpdatingUI and Options.HitboxSizeInput then
            isUpdatingUI = true
            Options.HitboxSizeInput:SetValue(tostring(v))
            isUpdatingUI = false
        end
    end})
    BRight2:AddInput('HitboxSizeInput', {Default = '25', Text = 'Precise Hitbox Size', Placeholder = 'e.g. 30', Finished = true, Callback = function(v)
        local num = tonumber(v)
        if num then
            currentHitbox.Size = num
            if not isUpdatingUI and Options.HitboxSize then
                isUpdatingUI = true
                Options.HitboxSize:SetValue(num)
                isUpdatingUI = false
            end
        end
    end})

    BRight2:AddSlider('HitboxTransparency', {Text = 'Visualizer Transparency', Default = 0.5, Min = 0, Max = 1, Rounding = 2, Callback = function(v) currentHitbox.Transparency = v end})

    local colorMap = {Red = {1, 0.2, 0.2}, Green = {0.2, 1, 0.2}, Blue = {0.2, 0.5, 1}, Yellow = {1, 1, 0.2}, Purple = {0.8, 0.2, 1}, Cyan = {0.2, 1, 1}, White = {1, 1, 1}}
    BRight2:AddDropdown('HitboxColor', {
        Values = {'Red', 'Green', 'Blue', 'Yellow', 'Purple', 'Cyan', 'White'}, Default = 'Red', Text = 'Visualizer Color',
        Callback = function(v) local c = colorMap[v]; if c then currentHitbox.ColorR, currentHitbox.ColorG, currentHitbox.ColorB = c[1], c[2], c[3] end end
    })

    BRight2:AddToggle('HitboxVisualizerToggle', {Text = 'Hitbox Visualizer', Default = false, Callback = function(v) if v then StartHitboxVisualizer() else StopHitboxVisualizer() end end})

    BRight2:AddButton('Save Timing to File', function()
        if selAnimId == "" then return Library:Notify("Error: No Animation ID specified!", 3) end
        if saveName == "" then return Library:Notify("Error: Press 'Set Timing Name' first to confirm a name!", 4) end

        if originalSaveName ~= "" and originalSaveName ~= saveName then
            DeleteTimingFile(originalSaveName)
        end

        local hb = {
            Size = currentHitbox.Size,
            Shape = currentHitbox.Shape,
            ColorR = currentHitbox.ColorR,
            ColorG = currentHitbox.ColorG,
            ColorB = currentHitbox.ColorB,
            Transparency = currentHitbox.Transparency
        }

        local ok, err = SaveTimingFile(saveName, selAnimId, currentPoints, hb)
        if ok then
            getgenv().ParryConfig.Profiles[selAnimId] = {Name = saveName, Points = currentPoints, Hitbox = hb, Enabled = true}
            originalSaveName = saveName
            pcall(RefreshAllDropdowns, true)
            if AnimDD then for disp, id in pairs(animValueMap) do if id == selAnimId then pcall(function() AnimDD:SetValue(disp) end); break end end end
            Library:Notify("Saved timing '" .. saveName .. "' & loaded.", 3)
        else
            Library:Notify("Failed: " .. tostring(err), 3)
        end
    end)

    -- ==========================================
    -- TAB 3: SETTINGS
    -- ==========================================
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({})
    SaveManager:SetFolder("Evtariware/Configs")
    SaveManager:BuildConfigSection(Tabs.Settings)
    ThemeManager:ApplyToTab(Tabs.Settings)

    local Menu = Tabs.Settings:AddLeftGroupbox('Menu')
    Menu:AddButton('Unload Script', function() Library:Unload() end)

    local keySuccess = pcall(function()
        if Menu.AddKeyPicker then
            local MenuKeybind = Menu:AddKeyPicker('MenuKeybind', {
                Default = 'RightShift',
                SyncToggleState = false,
                Mode = 'Toggle',
                Text = 'Toggle UI',
                NoUI = false
            })
            Library.ToggleKeybind = MenuKeybind
        elseif Menu.AddKeybind then
            local MenuKeybind = Menu:AddKeybind('MenuKeybind', {
                Default = 'RightShift',
                SyncToggleState = false,
                Mode = 'Toggle',
                Text = 'Toggle UI',
                NoUI = false
            })
            Library.ToggleKeybind = MenuKeybind
        else
            error("AddKeyPicker missing")
        end
    end)

    if not keySuccess then
        Menu:AddInput('MenuKeybindFallback', {
            Default = 'RightShift',
            Text = 'Toggle UI Key',
            Finished = true,
            Placeholder = 'RightShift',
            Callback = function() end
        })
        
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            local currentKey = Options.MenuKeybindFallback and Options.MenuKeybindFallback.Value or "RightShift"
            if input.KeyCode.Name == currentKey then
                Library:Toggle()
            end
        end)
    end

    -- BULLETPROOF CUSTOM CURSOR TOGGLE
    local cursorStateConn = nil
    local function UpdateCursorState(showCustom)
        Library.ShowCustomCursor = showCustom
        
        if cursorStateConn then
            cursorStateConn:Disconnect()
            cursorStateConn = nil
        end
        
        if not showCustom then
            UserInputService.MouseIconEnabled = true
            cursorStateConn = RunService.RenderStepped:Connect(function()
                UserInputService.MouseIconEnabled = true
                local function hideCursor(parent)
                    if not parent then return end
                    for _, v in ipairs(parent:GetDescendants()) do
                        if v:IsA("ImageLabel") and v.Name == "Cursor" then
                            v.Visible = false
                        end
                    end
                end
                hideCursor(Library.GUI)
                hideCursor(Library.Display)
            end)
        else
            UserInputService.MouseIconEnabled = false
            local function showCursor(parent)
                if not parent then return end
                for _, v in ipairs(parent:GetDescendants()) do
                    if v:IsA("ImageLabel") and v.Name == "Cursor" then
                        v.Visible = true
                    end
                end
            end
            showCursor(Library.GUI)
            showCursor(Library.Display)
        end
    end

    Menu:AddToggle('CustomCursor', {
        Text = 'Custom Cursor',
        Default = true,
        Callback = function(v)
            UpdateCursorState(v)
        end
    })
end)

if not uiSuccess then
    warn("[Evtariware] UI Build Error: " .. tostring(uiErr))
    Library:Notify("UI had an error, but script is running!", 5)
end

-- ==========================================
-- AUTO REFRESH LOOP
-- ==========================================
local lastAnimK, lastFilesK, lastLoadedK, lastBlK = "", "", "", ""

local function SafeSet(dd, vals)
    local cur = dd.Value; local valid = false
    if cur then for _, v in ipairs(vals) do if v == cur then valid = true; break end end end
    pcall(function() dd:SetValues(vals) end)
    if valid and cur then pcall(function() dd:SetValue(cur) end) end
end

RefreshAllDropdowns = function(force)
    local aL, aM, seen = {}, {}, {}
    for id, data in pairs(LoggedAnimations) do
        if not IsBlacklisted(id) and not seen[id] then
            seen[id] = true
            local p = getgenv().ParryConfig.Profiles[id]
            local disp = (p and p.Name and p.Name ~= "") and p.Name or data.Name
            if data.Source == "Self" and not (p and p.Name and p.Name ~= "") then disp = "[Self] " .. disp end
            local lbl = "[" .. id .. "] " .. disp
            if not aM[lbl] then aM[lbl] = id; table.insert(aL, lbl) end
        end
    end
    table.sort(aL); if #aL == 0 then table.insert(aL, "No animations logged yet") end
    local aK = table.concat(aL, "|")
    if force or aK ~= lastAnimK then lastAnimK = aK; animValueMap = aM; if AnimDD then SafeSet(AnimDD, aL) end end

    local fL = ListTimingFiles(); local fK = table.concat(fL, "|")
    if force or fK ~= lastFilesK then lastFilesK = fK; if TimingsDD then SafeSet(TimingsDD, fL) end end

    local lL = ListLoadedTimings(); local lK = table.concat(lL, "|")
    if force or lK ~= lastLoadedK then
        lastLoadedK = lK; loadedTimingMap = {}
        for _, lbl in ipairs(lL) do local id = lbl:match("%[(%d+)%]"); if id then loadedTimingMap[lbl] = id end end
        if LoadedDD then SafeSet(LoadedDD, lL) end
    end

    local bL = ListBlacklisted(); local bK = table.concat(bL, "|")
    if force or bK ~= lastBlK then lastBlK = bK; if BLDropdown then SafeSet(BLDropdown, bL) end end
end

pcall(RefreshAllDropdowns, true)
task.spawn(function() while true do task.wait(0.5); pcall(RefreshAllDropdowns) end end)

Library:OnUnload(function() StopLocalCharacterAnimation(); StopHitboxVisualizer() end)
Library:Notify("Evtariware Loaded! Auto-loaded " .. loadedCount .. " timing(s).", 5)

-- Autoload the most recent config
pcall(function()
    if SaveManager.LoadAutoloadConfig then
        SaveManager:LoadAutoloadConfig()
    end
end)
