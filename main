    BLeft_Saved:AddButton('Edit Selected File', function()
        local v = TimingsDD.Value
        if not v or v == "None" then return Library:Notify("No timing selected.", 3) end
        local dec = LoadTimingFile(v)
        if dec then PopulateUIForEdit(dec.AnimId); Library:Notify("Loaded '" .. v .. "' for editing.", 3)
        else Library:Notify("Failed to load timing.", 3) end
    end)
    BLeft_Saved:AddButton('Reload All Timings', function() getgenv().ParryConfig.Profiles = {}; local n = LoadAllTimings(); pcall(RefreshAllDropdowns, true); Library:Notify("Reloaded " .. n .. " timings.", 3) end)
    BLeft_Saved:AddButton('Delete Selected File', function()
