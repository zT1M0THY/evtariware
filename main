    if okLbl1 then FillLabel = l1 end
    local okLbl2, l2 = pcall(function() return HumanGroup:AddLabel('Counter 100% / Miss 0%') end)
    if okLbl2 then CntLabel = l2 end

    local function UpdateHumanReadout()
        local cfg = getgenv().ParryConfig
        local pr, pm = NormalizePair(cfg.HumanizeRollChance, cfg.HumanizeMissedReactionChance)
        local ch, cm = NormalizePair(cfg.HumanizeCounterChance, cfg.HumanizeMissedCounterChance)
        local parryLeft = 100 - pr - pm
        if parryLeft < 0 then parryLeft = 0 end
        if FillLabel then pcall(function() FillLabel:SetText(string.format('Roll %.0f%% / Miss %.0f%% / Parry %.0f%%', pr, pm, parryLeft)) end) end
        if CntLabel then pcall(function() CntLabel:SetText(string.format('Counter %.0f%% / Miss %.0f%%', ch, cm)) end) end
    end

    HumanGroup:AddSlider('HROLL', {Text = 'Roll Instead of Parry %', Default = 0, Min = 0, Max = 100, Rounding = 0, Callback = function(v) getgenv().ParryConfig.HumanizeRollChance = v; UpdateHumanReadout() end})
